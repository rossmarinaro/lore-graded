{
  "compilerOptions": {
    /* Target & Environment */
    "target": "ES2022",                               /* Output modern JavaScript */
    "module": "NodeNext",                             /* Match native Node.js resolution rules */
    "moduleResolution": "NodeNext",                   /* Ensures imports look up files correctly */

    /* Output Layout */
    "rootDir": "./src",                               /* Where your source files live */
    "outDir": "../dist",                               /* Where the compiled JS goes */
    "sourceMap": true,                                /* Maps errors in JS back to TS source code */
    "removeComments": true,                           /* Strip comments for smaller bundle output */

    /* Strictness & Safety */
    "strict": true,                                   /* Enables all strict type-checking options */
    "noImplicitAny": true,                            /* Error on expressions with inferred 'any' type */
    "noUnusedLocals": true,                           /* Flag unused local variables */
    "noUnusedParameters": true,                       /* Flag unused function parameters */
    "noUncheckedIndexedAccess": true,                 /* Adds 'undefined' to object map lookups */

    /* Interop & Optimization */
    "esModuleInterop": true,                          /* Simplifies importing CommonJS modules */
    "forceConsistentCasingInFileNames": true,         /* Ensures case-sensitive file naming safety */
    "skipLibCheck": true                              /* Skip type checking of declaration files (.d.ts) */
  },
  "include": ["src/**/*"],                            /* Files compiled by tsc */
  "exclude": ["node_modules", "../dist"],                /* Files completely ignored */
  "noUnusedLocals": false,
  "noUnusedParameters": false
}
